@page
@model OpenAlex.Web.Pages.Review.PublicationsModel

<h1>Publication Review Queue</h1>

<section class="card">

    <h2>@Model.DepartmentName</h2>

    <div class="review-actions">

        <a
            class="button secondary"
            asp-page="/Review/DepartmentDashboard"
            asp-route-DepartmentId="@Model.DepartmentId">
            Department Dashboard
        </a>

        <a
            class="button secondary"
            asp-page="/Review/PublicationStatus"
            asp-route-DepartmentId="@Model.DepartmentId">
            View Status &amp; History
        </a>

    </div>

    <p>
        Review current faculty-publication associations from the
        promoted reporting snapshot.
    </p>

    <p class="small">
        A Pending status means the faculty-publication association
        has not yet received a human review decision. It does not
        refer to a journal's editorial or manuscript status.
    </p>

</section>


<section class="card">

    <h2>Find Review Items</h2>

    <form method="get" class="filter-form">

        <input
            type="hidden"
            name="DepartmentId"
            value="@Model.DepartmentId" />

        <label>
            Search

            <input
                type="text"
                name="SearchText"
                value="@Model.SearchText"
                placeholder="faculty, UVA userid, title, DOI, venue" />
        </label>

        <div class="review-actions">

            <button type="submit">
                Search
            </button>

            <a
                class="button secondary"
                asp-page="/Review/Publications"
                asp-route-DepartmentId="@Model.DepartmentId">
                Reset
            </a>

        </div>

    </form>

    <p class="small">
        Showing @Model.Items.Count pending review item(s)@(
            Model.HasActiveFilters
                ? " matching the current search."
                : "."
        )
    </p>

</section>


@if (Model.Items.Count == 0)
{
    <section class="card">

        <h2>No pending publications</h2>

        <p>
            There are no pending faculty-publication associations
            matching the current search.
        </p>

    </section>
}
else
{
    <section
        class="publication-review-list"
        aria-label="Pending publication review items">

        @foreach (var item in Model.Items)
        {
            <article class="publication-review-card">

                <div class="publication-card-main">

                    <div>

                        <div class="publication-card-kicker">

                            <span class="badge PendingReview">
                                @item.ReviewStatus
                            </span>

                            @if (item.PublicationYear.HasValue)
                            {
                                <span class="publication-score">
                                    @item.PublicationYear
                                </span>
                            }

                        </div>


                        <h2 class="publication-card-title">
                            @ValueOrDash(item.WorkTitle)
                        </h2>


                        <div class="publication-card-meta">

                            <span>
                                <strong>Candidate:</strong>
                                @item.FacultyPublicationReviewCandidateId
                            </span>

                            <span>
                                <strong>Faculty:</strong>
                                @item.FacultyDisplayName
                            </span>

                            <span>
                                <strong>UVA UserID:</strong>
                                @ValueOrDash(item.UvaUserId)
                            </span>

                            <span>
                                <strong>Department:</strong>
                                @item.DepartmentName
                            </span>

                            @if (!string.IsNullOrWhiteSpace(item.Venue))
                            {
                                <span>
                                    <strong>Venue:</strong>
                                    @item.Venue
                                </span>
                            }

                        </div>


                        @if (!string.IsNullOrWhiteSpace(item.WorkDoi))
                        {
                            <p class="small">
                                <strong>DOI:</strong>
                                @item.WorkDoi
                            </p>
                        }


                        <div class="publication-links">

                            @if (!string.IsNullOrWhiteSpace(item.DoiUrl))
                            {
                                <a
                                    href="@item.DoiUrl"
                                    target="_blank"
                                    rel="noopener">
                                    Open DOI
                                </a>
                            }

                        </div>

                    </div>


                    <div class="publication-review-actions">

                        <form
                            method="post"
                            asp-page-handler="Accept">

                            <input
                                type="hidden"
                                name="id"
                                value="@item.FacultyPublicationReviewCandidateId" />

                            <input
                                type="hidden"
                                name="departmentId"
                                value="@Model.DepartmentId" />

                            <input
                                type="hidden"
                                name="searchText"
                                value="@Model.SearchText" />

                            <label
                                class="small"
                                for="accept-notes-@item.FacultyPublicationReviewCandidateId">
                                Accept notes
                            </label>

                            <input
                                id="accept-notes-@item.FacultyPublicationReviewCandidateId"
                                type="text"
                                name="notes"
                                placeholder="optional notes" />

                            <button type="submit">
                                Accept
                            </button>

                        </form>


                        <form
                            method="post"
                            asp-page-handler="Reject">

                            <input
                                type="hidden"
                                name="id"
                                value="@item.FacultyPublicationReviewCandidateId" />

                            <input
                                type="hidden"
                                name="departmentId"
                                value="@Model.DepartmentId" />

                            <input
                                type="hidden"
                                name="searchText"
                                value="@Model.SearchText" />

                            <label
                                class="small"
                                for="reject-notes-@item.FacultyPublicationReviewCandidateId">
                                Reject notes
                            </label>

                            <input
                                id="reject-notes-@item.FacultyPublicationReviewCandidateId"
                                type="text"
                                name="notes"
                                placeholder="optional notes" />

                            <button type="submit">
                                Reject
                            </button>

                        </form>

                    </div>

                </div>

            </article>
        }

    </section>
}


@functions
{
    private static string ValueOrDash(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "-"
            : value;
    }
}