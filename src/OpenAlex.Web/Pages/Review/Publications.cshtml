@page
@model OpenAlex.Web.Pages.Review.PublicationsModel

<h1>Publication Review Queue</h1>

<section class="card">
    <p>
        Review pending faculty-publication candidates. Accepting or rejecting a candidate records a current decision and removes it from this pending queue.
    </p>
    <p class="small">
        PATCH010 groups duplicate candidate rows so reviewers see one best review card per faculty/work pair.
    </p>
</section>

@if (Model.Items.Count == 0)
{
    <section class="card">
        <h2>No pending publication candidates</h2>
        <p>
            There are no pending publication candidates to review. Check the Accepted Publications report or the after-action SQL report.
        </p>
    </section>
}
else
{
    <section class="publication-review-list" aria-label="Pending publication candidates">
        @foreach (var item in Model.Items)
        {
            var affiliatedInstitutionMatchCount = ExtractEvidenceValue(item.EvidenceSummary, "AffiliatedInstitutionMatchCount");
            var affiliatedInstitutionEvidenceWeight = ExtractEvidenceValue(item.EvidenceSummary, "AffiliatedInstitutionEvidenceWeight");
            var affiliatedInstitutionNames = ExtractEvidenceValue(item.EvidenceSummary, "AffiliatedInstitutionNames");
            var knownCoauthorOverlapCount = ExtractEvidenceValue(item.EvidenceSummary, "KnownCoauthorOverlapCount");
            var knownCoauthorHistoricalPublicationCount = ExtractEvidenceValue(item.EvidenceSummary, "KnownCoauthorHistoricalPublicationCount");
            var knownCoauthorNames = ExtractEvidenceValue(item.EvidenceSummary, "KnownCoauthorNames");
            var evidenceBoost = ExtractEvidenceValue(item.EvidenceSummary, "EvidenceBoost");
            var duplicateCandidateCount = ExtractEvidenceValue(item.EvidenceSummary, "PATCH010DuplicateCandidateCount");
            var reviewGrouping = ExtractEvidenceValue(item.EvidenceSummary, "PATCH010ReviewGrouping");

            <article class="publication-review-card">
                <div class="publication-card-main">
                    <div>
                        <div class="publication-card-kicker">
                            <span class="badge @item.CandidateStatus">@ValueOrDash(item.CandidateStatus)</span>
                            <span class="publication-score">Score: @item.MatchScore</span>
                            @if (HasEvidenceValue(evidenceBoost))
                            {
                                <span class="badge Information">Boost: +@evidenceBoost</span>
                            }
                            @if (HasDuplicateCount(duplicateCandidateCount))
                            {
                                <span class="badge Warning">Grouped: @duplicateCandidateCount candidates</span>
                            }
                        </div>

                        <h2 class="publication-card-title">@item.WorkTitle</h2>

                        <div class="publication-card-meta">
                            <span><strong>Faculty:</strong> @item.FacultyDisplayName</span>
                            <span><strong>Matched author:</strong> @ValueOrDash(item.AuthorDisplayName)</span>
                            <span><strong>Year:</strong> @item.PublicationYear</span>
                            @if (!string.IsNullOrWhiteSpace(item.DepartmentName))
                            {
                                <span><strong>Department:</strong> @item.DepartmentName</span>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(reviewGrouping))
                        {
                            <p class="small">@reviewGrouping</p>
                        }

                        <div class="publication-links">
                            @if (!string.IsNullOrWhiteSpace(item.DoiUrl))
                            {
                                <a href="@item.DoiUrl" target="_blank" rel="noopener">DOI</a>
                            }
                            else if (!string.IsNullOrWhiteSpace(item.WorkOpenAlexId))
                            {
                                <a href="https://openalex.org/@item.WorkOpenAlexId" target="_blank" rel="noopener">OpenAlex</a>
                            }
                        </div>
                    </div>

                    <div class="publication-review-actions">
                        <form method="post" asp-page-handler="Accept">
                            <input type="hidden" name="id" value="@item.FacultyPublicationCandidateId" />
                            <label class="small" for="accept-notes-@item.FacultyPublicationCandidateId">Accept notes</label>
                            <input id="accept-notes-@item.FacultyPublicationCandidateId" type="text" name="notes" placeholder="optional notes" />
                            <button type="submit">Accept</button>
                        </form>
                        <form method="post" asp-page-handler="Reject">
                            <input type="hidden" name="id" value="@item.FacultyPublicationCandidateId" />
                            <label class="small" for="reject-notes-@item.FacultyPublicationCandidateId">Reject notes</label>
                            <input id="reject-notes-@item.FacultyPublicationCandidateId" type="text" name="notes" placeholder="optional notes" />
                            <button type="submit">Reject</button>
                        </form>
                    </div>
                </div>

                <div class="publication-evidence-grid">
                    <section class="evidence-panel">
                        <h3>Institution Evidence</h3>
                        @if (HasEvidenceValue(affiliatedInstitutionMatchCount))
                        {
                            <div class="evidence-badge-row">
                                <span class="evidence-badge positive">@affiliatedInstitutionMatchCount match(es)</span>
                                <span class="evidence-badge neutral">Weight @ValueOrDash(affiliatedInstitutionEvidenceWeight)</span>
                            </div>
                            <p>@ValueOrDash(affiliatedInstitutionNames)</p>
                        }
                        else
                        {
                            <p class="small">No PATCH009 institution evidence</p>
                        }
                    </section>

                    <section class="evidence-panel">
                        <h3>Coauthor Evidence</h3>
                        @if (HasEvidenceValue(knownCoauthorOverlapCount))
                        {
                            <div class="evidence-badge-row">
                                <span class="evidence-badge positive">@knownCoauthorOverlapCount overlap(s)</span>
                                <span class="evidence-badge neutral">@ValueOrDash(knownCoauthorHistoricalPublicationCount) prior accepted work(s)</span>
                            </div>
                            <p>@ValueOrDash(knownCoauthorNames)</p>
                        }
                        else
                        {
                            <p class="small">No PATCH009 coauthor evidence</p>
                        }
                    </section>

                    <section class="evidence-panel evidence-panel-wide">
                        <h3>Author Match Evidence</h3>
                        <p>
                            <strong>@ValueOrDash(item.AuthorDisplayName)</strong><br />
                            <span class="small">@ShortEvidence(item.EvidenceSummary)</span>
                        </p>
                    </section>
                </div>
            </article>
        }
    </section>
}

@functions {
    private static string? ExtractEvidenceValue(string? evidenceSummary, string key)
    {
        if (string.IsNullOrWhiteSpace(evidenceSummary) || string.IsNullOrWhiteSpace(key))
        {
            return null;
        }

        var pattern = key + "=";
        var start = evidenceSummary.IndexOf(pattern, StringComparison.OrdinalIgnoreCase);
        if (start < 0)
        {
            return null;
        }

        start += pattern.Length;
        var end = evidenceSummary.IndexOf(';', start);
        var value = end < 0
            ? evidenceSummary.Substring(start)
            : evidenceSummary.Substring(start, end - start);

        value = value.Trim();
        return string.IsNullOrWhiteSpace(value) || value == "(none)" ? null : value;
    }

    private static bool HasEvidenceValue(string? value)
    {
        return !string.IsNullOrWhiteSpace(value) && value != "0" && value != "0.0000";
    }

    private static bool HasDuplicateCount(string? value)
    {
        return int.TryParse(value, out var count) && count > 1;
    }

    private static string ValueOrDash(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : value;
    }

    private static string ShortEvidence(string? evidenceSummary)
    {
        if (string.IsNullOrWhiteSpace(evidenceSummary))
        {
            return "No evidence summary";
        }

        var patchMarker = evidenceSummary.IndexOf("PATCH007Evidence", StringComparison.OrdinalIgnoreCase);
        var compact = patchMarker >= 0 ? evidenceSummary.Substring(0, patchMarker).Trim().TrimEnd(';') : evidenceSummary.Trim();

        const int maxLength = 320;
        return compact.Length <= maxLength ? compact : compact.Substring(0, maxLength) + "...";
    }
}
