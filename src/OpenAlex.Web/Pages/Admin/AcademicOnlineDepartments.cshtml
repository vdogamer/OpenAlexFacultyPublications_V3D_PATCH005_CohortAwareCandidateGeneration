@page
@model OpenAlex.Web.Pages.Admin.AcademicOnlineDepartmentsModel
@{
    ViewData["Title"] = "Academic Online Department Catalog";
}

<h1>Academic Online Department Catalog</h1>

<section class="card">
    <p>
        Configure which synchronized Academic Online departments may refresh
        automatically. The web application only changes refresh policy and due
        timestamps; the background worker performs all API synchronization.
    </p>
    <p class="small">
        New departments are disabled by default. A complete refresh advances the
        normal interval. Failed or partial refreshes use the shorter retry interval.
        Department leases prevent overlapping workers from refreshing the same
        department at the same time.
    </p>

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <p><strong>@Model.Message</strong></p>
    }
</section>

<section class="card">
    <h2>Background Scheduler</h2>

    <p>
        <strong>Status:</strong>
        @Model.SchedulerHealthLabel
    </p>

    @if (Model.SchedulerState is null)
    {
        <p class="small">
            No scheduler heartbeat has been recorded yet.
        </p>
    }
    else
    {
        <p>
            <strong>Last heartbeat:</strong>
            @Model.SchedulerState.LastHeartbeatAtUtc.ToString("u")
            ·
            <strong>Mode:</strong>
            @(Model.SchedulerState.IsContinuous == true ? "Continuous" : "One pass")
        </p>

        <p class="small">
            Last pass:
            @(Model.SchedulerState.LastPassStatus ?? "unknown")
            @if (Model.SchedulerState.LastPassCompletedAtUtc.HasValue)
            {
                <span>
                    · completed @Model.SchedulerState.LastPassCompletedAtUtc.Value.ToString("u")
                </span>
            }
            @if (Model.SchedulerState.PollIntervalSeconds.HasValue)
            {
                <span>
                    · poll every @Model.SchedulerState.PollIntervalSeconds second(s)
                </span>
            }
        </p>

        <p class="small">
            Claimed @Model.SchedulerState.DepartmentsClaimed
            · Completed @Model.SchedulerState.DepartmentsCompleted
            · Partial @Model.SchedulerState.DepartmentsPartial
            · Failed @Model.SchedulerState.DepartmentsFailed
        </p>

        @if (!string.IsNullOrWhiteSpace(Model.SchedulerState.LastError))
        {
            <p class="small">
                <strong>Scheduler error:</strong>
                @Model.SchedulerState.LastError
            </p>
        }
    }
</section>

<section class="card">
    <h2>Discover Departments</h2>

    <p>
        Queue department onboarding for the School of Medicine. For this parent,
        the system uses UVA's official department roster as candidate units and
        validates each unit against Academic Online. The Windows Service performs
        the API work; this page only creates the request.
    </p>

    <form method="post"
          asp-page-handler="QueueDiscovery"
          class="filter-form">
        <label>
            Parent organization
            <input type="text"
                   name="parentName"
                   value="School of Medicine"
                   maxlength="512" />
        </label>

        <label>
            Fallback maximum scholar pages
            <input type="number"
                   name="maxPages"
                   value="100"
                   min="1"
                   max="1000" />
        </label>

        <button type="submit">
            Queue Department Discovery
        </button>
    </form>

    <p class="small">
        Validated departments are added to the local catalog with scheduled
        refresh disabled. Review each entry before enabling it. The page-limit
        setting is used only when no official seed roster exists for the parent.
    </p>

    @if (Model.DiscoveryStatus is not null)
    {
        <hr />

        <p>
            <strong>Latest request:</strong>
            @Model.DiscoveryStatus.RequestId
            ·
            <strong>Status:</strong>
            @Model.DiscoveryStatus.RequestStatus
            ·
            <strong>Parent:</strong>
            @Model.DiscoveryStatus.ParentName
        </p>

        <p class="small">
            Requested @Model.DiscoveryStatus.RequestedAtUtc.ToString("u")
            by @Model.DiscoveryStatus.RequestedBy
            · page size @Model.DiscoveryStatus.RowsPerPage
            · max pages @Model.DiscoveryStatus.MaxPages
        </p>

        @if (Model.DiscoveryStatus.DiscoveryRunId.HasValue)
        {
            <p class="small">
                Run @Model.DiscoveryStatus.DiscoveryRunId
                · @(Model.DiscoveryStatus.RunStatus ?? "unknown")
                · pages @(Model.DiscoveryStatus.PagesFetched?.ToString() ?? "0")
                · scholars @(Model.DiscoveryStatus.ScholarsScanned?.ToString() ?? "0")
                · departments @(Model.DiscoveryStatus.DepartmentsDiscovered?.ToString() ?? "0")
                · inserted @(Model.DiscoveryStatus.DepartmentsInserted?.ToString() ?? "0")
                · updated @(Model.DiscoveryStatus.DepartmentsUpdated?.ToString() ?? "0")
            </p>
        }

        @if (Model.DiscoveryStatus.HitMaxPages == true)
        {
            <p class="small">
                <strong>PARTIAL:</strong>
                The scholar-page safeguard was reached. The discovered catalog
                may not be exhaustive.
            </p>
        }

        @if (!string.IsNullOrWhiteSpace(Model.DiscoveryStatus.ErrorText))
        {
            <p class="small">
                <strong>Discovery error:</strong>
                @Model.DiscoveryStatus.ErrorText
            </p>
        }
    }
</section>

@if (Model.Departments.Count == 0)
{
    <section class="card">
        <p>
            No Academic Online departments are currently present in the local
            reporting store.
        </p>
    </section>
}
else
{
    @foreach (var department in Model.Departments)
    {
        <section class="card">
            <h2>@department.DepartmentName</h2>

            @if (department.DiscoveryLastSeenAtUtc.HasValue)
            {
                <p class="small">
                    <strong>Academic Online discovery:</strong>
                    @if (!string.IsNullOrWhiteSpace(department.ParentName))
                    {
                        <span>
                            parent @department.ParentName ·
                        </span>
                    }
                    @(department.DiscoveryScholarCount?.ToString() ?? "0")
                    observed scholar(s)
                    · last seen @department.DiscoveryLastSeenAtUtc.Value.ToString("u")
                </p>

                @if (!string.IsNullOrWhiteSpace(department.AcademicOnlineSlug) ||
                     !string.IsNullOrWhiteSpace(department.AcademicOnlineDepartmentId))
                {
                    <p class="small">
                        @if (!string.IsNullOrWhiteSpace(department.AcademicOnlineSlug))
                        {
                            <span>Slug: @department.AcademicOnlineSlug</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(department.AcademicOnlineDepartmentId))
                        {
                            <span>
                                · ID: @department.AcademicOnlineDepartmentId
                            </span>
                        }
                    </p>
                }
            }

            <p>
                <strong>Current snapshot:</strong>
                @(department.CurrentSnapshotRunId?.ToString() ?? "none")
                @if (department.CurrentSnapshotAtUtc.HasValue)
                {
                    <span>
                        · @department.CurrentSnapshotAtUtc.Value.ToString("u")
                    </span>
                }
            </p>

            <p>
                <strong>Next due:</strong>
                @(department.NextRefreshDueAtUtc?.ToString("u") ?? "not scheduled")
                ·
                <strong>Status:</strong>
                @(department.DueNow ? "DUE" : (department.RefreshEnabled ? "WAITING" : "DISABLED"))
            </p>

            @if (!string.IsNullOrWhiteSpace(department.LastRefreshAttemptStatus))
            {
                <p class="small">
                    Last scheduler attempt:
                    @department.LastRefreshAttemptStatus
                    @if (department.LastRefreshAttemptRunId.HasValue)
                    {
                        <span>
                            · Run @department.LastRefreshAttemptRunId
                        </span>
                    }
                    @if (department.LastRefreshAttemptAtUtc.HasValue)
                    {
                        <span>
                            · @department.LastRefreshAttemptAtUtc.Value.ToString("u")
                        </span>
                    }
                </p>
            }

            @if (!string.IsNullOrWhiteSpace(department.LastRefreshError))
            {
                <p class="small">
                    <strong>Last error:</strong>
                    @department.LastRefreshError
                </p>
            }

            @if (department.RefreshLeaseUntilUtc.HasValue &&
                 department.RefreshLeaseUntilUtc > DateTime.UtcNow)
            {
                <p class="small">
                    <strong>Lease:</strong>
                    @department.RefreshLeaseOwner
                    until @department.RefreshLeaseUntilUtc.Value.ToString("u")
                </p>
            }

            <form method="post"
                  asp-page-handler="SavePolicy"
                  class="filter-form">
                <input type="hidden"
                       name="departmentId"
                       value="@department.DepartmentId" />

                <label class="checkbox-label">
                    <input type="checkbox"
                           name="refreshEnabled"
                           value="true"
                           checked="@department.RefreshEnabled" />
                    Enable scheduled refresh
                </label>

                <label>
                    Normal interval (hours)
                    <input type="number"
                           name="refreshIntervalHours"
                           min="1"
                           max="8760"
                           value="@department.RefreshIntervalHours" />
                </label>

                <label>
                    Retry after partial/failure (minutes)
                    <input type="number"
                           name="refreshFailureRetryMinutes"
                           min="5"
                           max="1440"
                           value="@department.RefreshFailureRetryMinutes" />
                </label>

                <label>
                    From year
                    <input type="number"
                           name="refreshFromYear"
                           value="@department.RefreshFromYear"
                           placeholder="all years" />
                </label>

                <label>
                    To year
                    <input type="number"
                           name="refreshToYear"
                           value="@department.RefreshToYear"
                           placeholder="present" />
                </label>

                <label class="checkbox-label">
                    <input type="checkbox"
                           name="refreshVerifiedOnly"
                           value="true"
                           checked="@department.RefreshVerifiedOnly" />
                    Verified publications only
                </label>

                <label>
                    Maximum scholars
                    <input type="number"
                           name="refreshMaxScholars"
                           min="1"
                           max="5000"
                           value="@department.RefreshMaxScholars" />
                </label>

                <button type="submit">Save Policy</button>
            </form>

            @if (department.RefreshEnabled &&
                 (!department.RefreshLeaseUntilUtc.HasValue ||
                  department.RefreshLeaseUntilUtc <= DateTime.UtcNow))
            {
                <form method="post"
                      asp-page-handler="DueNow"
                      style="margin-top:1rem">
                    <input type="hidden"
                           name="departmentId"
                           value="@department.DepartmentId" />
                    <button type="submit">
                        Mark Due Now
                    </button>
                </form>
            }
        </section>
    }
}
