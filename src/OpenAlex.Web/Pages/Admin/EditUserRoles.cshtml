@page
@model OpenAlex.Web.Pages.Admin.EditUserRolesModel
<h1>Admin: Edit User Roles</h1>
@if (Model.UserProfile is null) { <section class="card"><p>User was not found.</p><a class="button" href="/Admin/Roles">Back</a></section> } else { <section class="card"><h2>@Model.UserProfile.UserName</h2><p>@Model.UserProfile.DisplayName</p><p>@Model.UserProfile.Email</p><p>Enabled: @Model.UserProfile.IsEnabled</p></section>@if(!string.IsNullOrWhiteSpace(Model.ErrorMessage)){<section class="notice">@Model.ErrorMessage</section>}<form method="post" class="card"><input type="hidden" asp-for="Id" /><h2>Roles</h2>@foreach(var role in Model.Roles){var isChecked=Model.SelectedRoleIds.Contains(role.AppRoleId);<label><input type="checkbox" name="SelectedRoleIds" value="@role.AppRoleId" checked="@isChecked" /> @role.RoleName</label><br />}<br /><label>Reason</label><br /><textarea asp-for="ChangeReason" rows="4"></textarea><br /><br /><button type="submit">Save Roles</button> <a class="button" href="/Admin/Roles">Cancel</a></form> }
