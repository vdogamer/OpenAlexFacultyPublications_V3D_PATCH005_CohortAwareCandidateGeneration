@page
@model OpenAlex.Web.Pages.Faculty.MyPublicationsModel
@{
    ViewData["Title"] = "My Publications";
}

<div class="my-publications-header">
    <div>
        <h1>My Publications</h1>
        <p>
            Review your Academic Online publications and copy the list into your
            faculty profile.
        </p>
    </div>
</div>

<ol class="my-publications-steps" aria-label="Publication update steps">
    <li>
        <span class="step-number">1</span>
        <span><strong>Choose</strong><br />Select which publications to show.</span>
    </li>
    <li>
        <span class="step-number">2</span>
        <span><strong>Review</strong><br />Make sure the list looks right.</span>
    </li>
    <li>
        <span class="step-number">3</span>
        <span><strong>Copy</strong><br />Paste the list into your profile.</span>
    </li>
</ol>

<section class="card">
    <h2>1. Choose publications</h2>

    <div class="publication-range-options" aria-label="Publication range">
        <a class="button @(Model.Range == "all" ? "range-active" : "secondary")"
           asp-route-Range="all"
           asp-route-VerifiedOnly="@Model.VerifiedOnly"
           asp-route-Keyword="@Model.Keyword"
           asp-route-KeywordMatchMode="@Model.KeywordMatchMode">
            All publications
        </a>

        <a class="button @(Model.Range == "10" ? "range-active" : "secondary")"
           asp-route-Range="10"
           asp-route-VerifiedOnly="@Model.VerifiedOnly"
           asp-route-Keyword="@Model.Keyword"
           asp-route-KeywordMatchMode="@Model.KeywordMatchMode">
            Last 10 years
        </a>

        <a class="button @(Model.Range == "5" ? "range-active" : "secondary")"
           asp-route-Range="5"
           asp-route-VerifiedOnly="@Model.VerifiedOnly"
           asp-route-Keyword="@Model.Keyword"
           asp-route-KeywordMatchMode="@Model.KeywordMatchMode">
            Last 5 years
        </a>
    </div>

    <form method="get" class="my-publications-options">
        <input type="hidden" name="Range" value="@Model.Range" />
        <input type="hidden" name="FromYear" value="@Model.FromYear" />
        <input type="hidden" name="ToYear" value="@Model.ToYear" />

        <label class="publication-keyword-field">
            Keyword or topic
            <input type="text"
                   name="Keyword"
                   value="@Model.Keyword"
                   maxlength="500"
                   placeholder="e.g. cancer, genomics" />
        </label>

        <label>
            Match
            <select name="KeywordMatchMode">
                @if (Model.KeywordMatchModeLabel == "ALL")
                {
                    <option value="any">ANY keyword</option>
                    <option value="all" selected>ALL keywords</option>
                }
                else
                {
                    <option value="any" selected>ANY keyword</option>
                    <option value="all">ALL keywords</option>
                }
            </select>
        </label>

        <label class="checkbox-label">
            <input type="checkbox"
                   name="VerifiedOnly"
                   value="true"
                   checked="@Model.VerifiedOnly" />
            Show only publications verified in Academic Online
        </label>

        <button type="submit">Apply Filters</button>

        @if (Model.HasKeywordFilter)
        {
            <a class="button secondary"
               asp-route-Range="@Model.Range"
               asp-route-VerifiedOnly="@Model.VerifiedOnly"
               asp-route-FromYear="@Model.FromYear"
               asp-route-ToYear="@Model.ToYear">
                Clear keyword
            </a>
        }
    </form>

    <details class="advanced-publication-options"
             open="@(Model.Range == "custom" ? "open" : null)">
        <summary>Advanced options: custom year range</summary>

        <form method="get" class="filter-form">
            <input type="hidden" name="Range" value="custom" />
            <input type="hidden" name="Keyword" value="@Model.Keyword" />
            <input type="hidden" name="KeywordMatchMode" value="@Model.KeywordMatchMode" />

            <label>
                From year
                <input type="number"
                       name="FromYear"
                       value="@Model.FromYear"
                       min="1800"
                       max="@(DateTime.UtcNow.Year + 1)"
                       placeholder="e.g. 2020" />
            </label>

            <label>
                To year
                <input type="number"
                       name="ToYear"
                       value="@Model.ToYear"
                       min="1800"
                       max="@(DateTime.UtcNow.Year + 1)"
                       placeholder="e.g. @DateTime.UtcNow.Year" />
            </label>

            <label class="checkbox-label">
                <input type="checkbox"
                       name="VerifiedOnly"
                       value="true"
                       checked="@Model.VerifiedOnly" />
                Verified only
            </label>

            <button type="submit">Apply custom range</button>
        </form>
    </details>
</section>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <section class="card">
        <h2>Publications unavailable</h2>
        <p class="notice">@Model.ErrorMessage</p>
    </section>
}
else if (Model.Result is not null)
{
    <section class="card publication-summary-card">
        <div>
            <span class="small">Signed in as</span>
            <h2>@Model.Result.Profile.Name</h2>

            @if (!string.IsNullOrWhiteSpace(Model.Result.Profile.Department))
            {
                <p>@Model.Result.Profile.Department</p>
            }
        </div>

        <div class="publication-summary-count">
            <strong>@Model.Result.Publications.Count</strong>
            <span>
                matching publication@(Model.Result.Publications.Count == 1 ? "" : "s")
            </span>
            <small>@Model.RangeLabel</small>

            @if (Model.HasKeywordFilter)
            {
                <small>
                    from @Model.Result.UnfilteredPublicationCount before keyword filtering
                </small>
            }
        </div>

        @if (Model.HasKeywordFilter)
        {
            <p class="publication-filter-summary">
                <strong>Keyword filter:</strong>
                @Model.Result.KeywordQuery
                <span class="badge">@Model.KeywordMatchModeLabel</span>
                <span class="small">Matches title, Academic Online keywords, or venue/journal.</span>
            </p>
        }

        @if (Model.Result.HitMaxPages)
        {
            <p class="notice">
                Your publication list reached the retrieval safeguard. Please contact
                the faculty-profile administrator before copying the list.
            </p>
        }
    </section>

    <section class="card">
        <h2>2. Review</h2>
        <p class="small">
            Scan the list below before copying it to your faculty profile.
        </p>

        <div id="generatedPublicationProfileContent"
             class="faculty-publication-preview">
            @Html.Raw(Model.GeneratedHtmlFragment)
        </div>
    </section>

    <section class="card copy-profile-card">
        <h2>3. Copy to my profile</h2>

        <p>
            When the list looks correct, copy it and paste it into your faculty
            profile editor with <kbd>Ctrl</kbd>+<kbd>V</kbd>.
        </p>

        <div class="review-actions">
            <button type="button"
                    id="copyProfileReadyPublications"
                    class="copy-primary-button"
                    data-copy-action="profile-ready">
                Copy My Publications
            </button>

            @if (!string.IsNullOrWhiteSpace(Model.FacultyProfileEditUrl))
            {
                <a class="button secondary"
                   href="@Model.FacultyProfileEditUrl"
                   target="_blank"
                   rel="noopener">
                    Open My Faculty Profile
                </a>
            }
        </div>

        <p id="publicationCopyStatus"
           class="copy-status"
           role="status"
           aria-live="polite"></p>

        @if (!string.IsNullOrWhiteSpace(Model.FacultyProfileEditUrl))
        {
            <p class="small">
                After copying, open your Pubs / HTML profile editor, paste with
                <kbd>Ctrl</kbd>+<kbd>V</kbd>, review the result, and save.
            </p>
        }
        else
        {
            <p class="small">
                We could not determine your Research Faculty Directory editor link.
                You can still copy the publications and open your faculty profile manually.
            </p>
        }

        <details class="advanced-publication-options">
            <summary>Need HTML instead?</summary>
            <p class="small">
                Use this only when the profile form specifically asks you to paste HTML source.
            </p>

            <button type="button"
                    id="copyPublicationHtmlSource"
                    class="button secondary"
                    data-copy-action="html-source">
                Copy HTML Source
            </button>
        </details>
    </section>

    <textarea id="generatedPublicationHtmlSource"
              hidden
              aria-hidden="true">@Model.GeneratedHtmlFragment</textarea>
}

<script src="/js/academic-online-publications-copy.js" defer></script>
