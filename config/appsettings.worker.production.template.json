{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SQL_SERVER;Database=OpenAlexIngestion;Integrated Security=True;TrustServerCertificate=True;"
  },
  "Database": {
    "ConnectionString": "Server=YOUR_SQL_SERVER;Database=OpenAlexIngestion;Integrated Security=True;TrustServerCertificate=True;"
  },
  "OpenAlex": {
    "BaseUrl": "https://api.openalex.org",
    "MailTo": "your-team-email@virginia.edu",
    "ApiKey": "YOUR_OPENALEX_API_KEY",
    "PerPage": 100,
    "InstitutionIds": [
      "I4210107925",
      "I4210119250",
      "I4210134211"
    ]
  },
  "OperationalLogging": {
    "SourceApplication": "OpenAlex.V3D.Production.Worker",
    "EnvironmentName": "Production",
    "EnableDatabaseLogging": true
  },
  "Worker": {
    "Enabled": false,
    "JobName": "ProcessQueuedJobRequests",
    "RunOnceAndStop": true,
    "DelaySeconds": 10
  },
  "Pipeline": {
    "StopOnFirstFailure": true,
    "JobSequence": [
      "InstitutionIngestion",
      "AuthorIngestion",
      "WorkIngestion",
      "FacultyAuthorCandidateGeneration",
      "FacultyPublicationCandidateGeneration"
    ]
  },
  "InstitutionIngestion": {
    "RunMode": "TestLoad",
    "MaxPages": 1,
    "MaxRecords": 10,
    "StartedBy": "OpenAlex.V3D.Production.Worker",
    "ApplicationVersion": "3D"
  },
  "AuthorIngestion": {
    "RunMode": "TestLoad",
    "MaxPages": 1,
    "MaxRecords": 100,
    "StartedBy": "OpenAlex.V3D.Production.Worker",
    "ApplicationVersion": "3D"
  },
  "WorkIngestion": {
    "RunMode": "TestLoad",
    "MaxPages": 1,
    "MaxRecords": 100,
    "StartedBy": "OpenAlex.V3D.Production.Worker",
    "ApplicationVersion": "3D"
  },
  "CandidateGeneration": {
    "RunMode": "TestLoad",
    "MaxFacultyToProcess": 25,
    "MaxAuthorsToScan": 500,
    "MaxCandidatesPerFaculty": 10,
    "MaxPublicationCandidatesToGenerate": 500,
    "MinimumNameScore": 50,
    "MinimumMatchScore": 60,
    "OnlyCurrentAcceptedAuthorDecisions": true,
    "PublicationCandidateStatus": "PendingReview",
    "StartedBy": "OpenAlex.V3D.Production.Worker",
    "ApplicationVersion": "3D"
  },
  "QueuedJobProcessor": {
    "MaxRequestsPerRun": 1,
    "StopOnFirstFailure": true,
    "WorkerApplicationVersion": "3B"
  },
  "ExecutionWindows": {
    "EnforceExecutionWindows": false,
    "AllowWhenWindowTableMissing": true
  }
}